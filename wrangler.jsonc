{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "itsjarvis",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "0dd43470-df0e-407d-b49b-b0ce0c711968","database_name": "itsjarvis" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d4a48fa76dd943fba4cb3b04de1e59b1" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
